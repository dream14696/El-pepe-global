local function addMessage(name, text, mine, system)
	order += 1
	local grouped = (not system) and lastName == name and lastMine == mine

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 0)
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.BackgroundTransparency = 1
	row.LayoutOrder = order
	row.Parent = Scroll
	if not grouped and #rows > 0 then
		pad(row, 0, 6, 0, 0)
	end

	local bubble = Instance.new("Frame")
	bubble.AutomaticSize = Enum.AutomaticSize.XY
	bubble.Size = UDim2.fromOffset(0, 0)
	bubble.Parent = row
	corner(bubble, 10)
	pad(bubble, 10, 6, 10, 6)

	local lay = Instance.new("UIListLayout")
	lay.Padding = UDim.new(0, 2)
	lay.SortOrder = Enum.SortOrder.LayoutOrder
	lay.Parent = bubble

	if system then
		bubble.AnchorPoint = Vector2.new(0.5, 0)
		bubble.Position = UDim2.fromScale(0.5, 0)
		bubble.BackgroundColor3 = C.input
		bubble.BackgroundTransparency = 0.2
		makeLabel(bubble, text, Enum.Font.Gotham, 12, C.sub, 2)
		lastName, lastMine = nil, nil
	else
		bubble.AnchorPoint = Vector2.new(mine and 1 or 0, 0)
		bubble.Position = UDim2.fromScale(mine and 1 or 0, 0)
		if mine then
			bubble.BackgroundColor3 = C.mine
			bubble.BackgroundTransparency = 0.1
		else
			bubble.BackgroundColor3 = C.other
			bubble.BackgroundTransparency = 0.1
		end
		if not grouped then
			makeLabel(bubble, name, Enum.Font.GothamBold, 12, nameColor(name), 1)
		end
		makeLabel(bubble, text, Enum.Font.Gotham, 14, C.text, 2)
		makeLabel(bubble, os.date("%H:%M"), Enum.Font.Gotham, 10, C.sub, 3)
		lastName, lastMine = name, mine
	end

	table.insert(rows, row)
	if #rows > MAX_MESSAGES then
		local r = table.remove(rows, 1)
		r:Destroy()
	end
	scrollToBottom()
end

local function refreshConstraints()
	local m = bubbleMax() - 20
	for i = #constraints, 1, -1 do
		local uc = constraints[i]
		if uc.Parent then
			uc.MaxSize = Vector2.new(m, math.huge)
		else
			table.remove(constraints, i)
		end
	end
	scrollToBottom()
end

local Chat = { AddMessage = addMessage, OnSend = nil, BotEnabled = false }
_G.MM2_CHAT = Chat

local lastSend = 0
local function send()
	task.wait(0.05)
	local msg = Input.Text:match("^%s*(.-)%s*$")
	if not msg or #msg == 0 then return end
	if os.clock() - lastSend < SEND_COOLDOWN then return end
	lastSend = os.clock()
	Input.Text = ""
	addMessage(lp.DisplayName, msg, true)
	if Chat.OnSend then task.spawn(pcall, Chat.OnSend, msg) end
	if Chat.BotEnabled then
		task.delay(0.7, function()
			if gui and gui.Parent then
				addMessage("Bot", "test funcionando", false)
			end
		end)
	end
end

connect(SendBtn.MouseButton1Click, send)
connect(Input.FocusLost, function(enter)
	if enter then
		send()
		task.defer(function() Input:CaptureFocus() end)
	end
end)

