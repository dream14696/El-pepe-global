connect(UIS.InputChanged, function(i)
	if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
	local cur = Vector2.new(i.Position.X, i.Position.Y)

	if moving then
		local currentSize = minimized and Vector2.new(MINI_W, HEAD_H) or Main.AbsoluteSize
		local p = clampPos(moveOrigin + (cur - moveStart), currentSize)
		if minimized then minPos = p else maxPos = p end
		Main.Position = UDim2.fromOffset(p.X, p.Y)
	elseif resizing and not minimized then
		local s = screen()
		local pos = Main.AbsolutePosition
		local nw = math.clamp(resOrigin.X + (cur.X - resStart.X), MIN_W, math.max(MIN_W, s.X - pos.X))
		local nh = math.clamp(resOrigin.Y + (cur.Y - resStart.Y), MIN_H, math.max(MIN_H, s.Y - pos.Y))
		maxSize = Vector2.new(nw, nh)
		Main.Size = UDim2.fromOffset(nw, nh)
		refreshConstraints()
	end
end)

