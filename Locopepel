-- ====================================================
-- CONEXIÓN GLOBAL (Firebase Realtime Database REST)
-- ====================================================
local req = (syn and syn.request) or (http and http.request) or http_request or request
local myId = tostring(lp.UserId)

local function call(method, url, body)
	if not req then return nil end
	local ok, r = pcall(req, {
		Url = DB .. url,
		Method = method,
		Headers = { ["Content-Type"] = "application/json" },
		Body = body and HttpService:JSONEncode(body) or nil,
	})
	if ok and r and r.StatusCode == 200 then
		if r.Body == "null" then return {} end
		local ok2, data = pcall(function() return HttpService:JSONDecode(r.Body) end)
		if ok2 then return data end
	end
	return nil
end

if not req then
	addMessage("", "Tu executor no soporta requests HTTP: el chat global no funcionará.", false, true)
else
	Chat.BotEnabled = false

	Chat.OnSend = function(msg)
		local res = call("POST", "/messages.json", {
			name = string.sub(lp.DisplayName, 1, 30),
			uid = myId,
			text = string.sub(msg, 1, MAX_LEN),
			ts = { [".sv"] = "timestamp" },
		})
		if not res and gui and gui.Parent then
			addMessage("", "No se pudo enviar el mensaje.", false, true)
		end
	end

	task.spawn(function()
		local lastTs = 0
		local first = true
		while gui and gui.Parent do
			local url
			if first then
				url = '/messages.json?orderBy=%22ts%22&limitToLast=' .. HISTORY_LIMIT
			else
				url = '/messages.json?orderBy=%22ts%22&startAt=' .. (lastTs + 1)
			end
			local data = call("GET", url)
			if type(data) == "table" then
				local msgs = {}
				for _, m in pairs(data) do
					if type(m) == "table" and type(m.ts) == "number" then
						table.insert(msgs, m)
					end
				end
				table.sort(msgs, function(a, b) return a.ts < b.ts end)
				for _, m in ipairs(msgs) do
					lastTs = math.max(lastTs, m.ts)
					if gui and gui.Parent and (m.uid ~= myId or first) then
						addMessage(tostring(m.name or "?"), tostring(m.text or ""), m.uid == myId)
					end
				end
				first = false
			elseif first and data == nil then
				-- sin respuesta aún; reintenta
			end
			task.wait(POLL_INTERVAL)
		end
	end)

	-- ====================================================
	-- USUARIOS EN LÍNEA
	-- ====================================================
	local PRESENCE_BEAT    = 5       -- latido propio cada 5 s
	local PRESENCE_TIMEOUT = 15000   -- ms sin latido = desconectado
	local COUNT_INTERVAL   = 0.25    -- el contador se actualiza cada 0.25 s

	local serverOffset = nil
	local onlineCount = nil

	local function renderOnline()
		if not onlineCount then return end
		local n = onlineCount
		local full = (n == 1) and "hay 1 usuario en línea en el chat"
			or ("hay " .. n .. " usuarios en línea en el chat")
		local short = (n == 1) and "1 en línea" or (n .. " en línea")
		local txt = (Online.AbsoluteSize.X >= 200) and full or short
		if Online.Text ~= txt then Online.Text = txt end
	end

	local function beat()
		local ok, r = pcall(req, {
			Url = DB .. "/presence/" .. myId .. ".json",
			Method = "PUT",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({ [".sv"] = "timestamp" }),
		})
		if ok and type(r) == "table" and r.StatusCode == 200 then
			local ts = tonumber(r.Body)
			if ts then
				serverOffset = ts - os.time() * 1000
			elseif not serverOffset then
				serverOffset = 0
			end
		end
	end

	task.spawn(function()
		while gui and gui.Parent do
			beat()
			task.wait(PRESENCE_BEAT)
		end
	end)

	task.spawn(function()
		while gui and gui.Parent do
			if serverOffset then
				local cutoff = os.time() * 1000 + serverOffset - PRESENCE_TIMEOUT
				local data = call("GET", '/presence.json?orderBy=%22%24value%22&startAt=' .. string.format("%d", cutoff))
				if type(data) == "table" then
					local n = 0
					for _ in pairs(data) do n += 1 end
					onlineCount = math.max(n, 1)
				end
			end
			renderOnline()
			task.wait(COUNT_INTERVAL)
		end
	end)

	-- al cerrar el chat, te quita de la lista de conectados
	gui.Destroying:Connect(function()
		task.spawn(call, "DELETE", "/presence/" .. myId .. ".json")
	end)
end
