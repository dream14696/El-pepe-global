local function makeCard(parent, data, n)
	local card = Instance.new("Frame")
	card.LayoutOrder = n
	card.BackgroundColor3 = C.header
	card.BackgroundTransparency = 0.25
	card.Parent = parent
	corner(card, 10)

	local stroke = Instance.new("UIStroke")
	stroke.Color = C.accent
	stroke.Thickness = 2
	stroke.Enabled = false
	stroke.Parent = card

	local prev
	if data.color then
		prev = Instance.new("Frame")
		prev.BackgroundColor3 = data.color
		prev.BackgroundTransparency = data.default and DEFAULT_BG_TRANSPARENCY or 0
		prev.BorderSizePixel = 0
		if data.default then prev.BackgroundTransparency = DEFAULT_BG_TRANSPARENCY end
	else
		prev = Instance.new("ImageLabel")
		prev.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		prev.BorderSizePixel = 0
		prev.ScaleType = Enum.ScaleType.Crop
		prev.Image = "rbxassetid://" .. data.id
		resolveImage(data.id, function(tex)
			if prev and prev.Parent then prev.Image = tex end
		end)
	end
	prev.Size = UDim2.new(1, -12, 0, 84)
	prev.Position = UDim2.fromOffset(6, 6)
	prev.Parent = card
	corner(prev, 8)

	local nameL = textLabel(card, data.name, Enum.Font.GothamBold, 12, C.text, UDim2.fromOffset(8, 94), UDim2.new(1, -16, 0, 30))
	nameL.TextWrapped = true
	nameL.TextYAlignment = Enum.TextYAlignment.Top
	nameL.TextTruncate = Enum.TextTruncate.AtEnd

	local credL = textLabel(card, "por " .. (data.creator or "..."), Enum.Font.Gotham, 11, C.sub, UDim2.fromOffset(8, 128), UDim2.new(1, -16, 0, 16))
	credL.TextTruncate = Enum.TextTruncate.AtEnd

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromScale(1, 1)
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.ZIndex = 5
	btn.Parent = card
	connect(btn.MouseButton1Click, function() selectCard(data) end)

	table.insert(cards, { data = data, stroke = stroke })
	data.nameLabel, data.creatorLabel = nameL, credL
end

